+def _sandlock_read_roots() -> tuple[str, ...]:
+    roots = [Path("/usr"), Path("/lib"), Path("/etc/ld.so.cache")]
+    roots.extend(Path(value) for value in sorted({sys.prefix, sys.base_prefix}))
+    canonical: dict[str, None] = {}
+    for root in roots:
+        if root.exists():
+            canonical[str(root.resolve())] = None
+    return tuple(canonical)
 
 
